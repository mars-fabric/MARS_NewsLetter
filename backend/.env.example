# ──────────────────────────────────────────────────────────────────────────────
# MARS-NewsLetter — backend environment configuration
# Copy to backend/.env and fill in the values that apply to your setup.
# (`run.py` / `core/config.py` read environment variables at startup; ProviderRegistry
# inside mars_cmbagent consumes the LLM credentials.)
# ──────────────────────────────────────────────────────────────────────────────

# ── App / server ──────────────────────────────────────────────────────────────
NEWSLETTER_APP_TITLE=MARS-NewsLetter API
NEWSLETTER_APP_VERSION=0.1.0
NEWSLETTER_DEBUG=false

# Bind address and port for the FastAPI server. `run.py` reads these.
HOST=0.0.0.0
PORT=8000
# Set to "true" to enable uvicorn auto-reload (development only).
NEWSLETTER_ENABLE_RELOAD=false

# Comma-separated list of allowed CORS origins for the API.
NEWSLETTER_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Where stage outputs (markdown, JSON, PDF) and logs are written.
# Created automatically on startup if it does not already exist.
NEWSLETTER_DEFAULT_WORK_DIR=~/Desktop/cmbdir

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=false
# Leave LOG_FILE blank to use the default ($work_dir/logs/backend.log).
LOG_FILE=

# ── LLM providers (one of these must be configured) ───────────────────────────
# OpenAI direct
OPENAI_API_KEY=

# Anthropic direct (Claude API)
ANTHROPIC_API_KEY=

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_VERIFY_SSL=true

# AWS Bedrock (Claude on Bedrock)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1
AWS_PROFILE=

# Google (Gemini) — optional
GOOGLE_API_KEY=

# ── Per-role model overrides (optional, consumed by cmbagent's model_registry) ─
# Override any role globally without editing model_config.yaml. Most users only
# need to set CMBAGENT_DEFAULT_MODEL when running on AWS Bedrock.
# CMBAGENT_DEFAULT_MODEL=
# CMBAGENT_PLANNER_MODEL=
# CMBAGENT_PLAN_REVIEWER_MODEL=
# CMBAGENT_RESEARCHER_MODEL=
# CMBAGENT_ORCHESTRATION_MODEL=
# CMBAGENT_FORMATTER_MODEL=

# ── Long-form newsletter generation ───────────────────────────────────────────
# Stage 4 writes the newsletter section-by-section (PaperPulse pattern) so the
# final draft can be 60–90 KB instead of being clipped at cmbagent's per-message
# content cap. Set to 0 to fall back to the legacy single-call writer.
STAGE4_SECTION_MODE=1

# cmbagent ships a hardcoded 25 000-char per-message content limit that
# splices a "[content truncated: N → M chars]" banner into long messages. We
# raise it at startup; tune here if you need bigger or smaller windows.
CMBAGENT_MAX_MSG_CONTENT_CHARS=200000

# Stage 5 editor max output tokens. Must comfortably cover the longest draft
# you expect to produce; the regression guard in report_assembly_node falls
# back to the unedited draft if the editor output is too short, so under-
# provisioning silently disables the surgical-edit pass.
STAGE5_EDITOR_MAX_TOKENS=32000

# Optional: pin the Stage 5 model name (passes through to litellm verbatim).
# STAGE5_MODEL=

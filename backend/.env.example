# ─────────────────────────────────────────────────────────────────────────────
# MARS-NewsLetter — backend environment configuration (example)
#
# Copy this file to `backend/.env` and fill in the values for your
# deployment. Only the App/server block plus ONE of the LLM provider blocks
# below is strictly required. Every other block is optional.
#
#   cp backend/.env.example backend/.env
#
# `run.py` reads this file at startup and hands the variables to:
#   - core/config.py                        (server, logging, work dir)
#   - mars_cmbagent.ProviderRegistry        (all LLM provider credentials)
# ─────────────────────────────────────────────────────────────────────────────


# ─── App / server ───────────────────────────────────────────────────────────
NEWSLETTER_APP_TITLE=MARS-NewsLetter API
NEWSLETTER_APP_VERSION=1.0.0
NEWSLETTER_DEBUG=false

# Bind address and port for the FastAPI server (used by run.py).
HOST=0.0.0.0
PORT=8000

# Uvicorn auto-reload — development only.
NEWSLETTER_ENABLE_RELOAD=false

# Comma-separated list of allowed CORS origins.
NEWSLETTER_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Where stage outputs (markdown / JSON / PDF) and logs are written.
# Relative paths resolve against the backend/ directory.
NEWSLETTER_DEFAULT_WORK_DIR=./cmbdir_newsletter


# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=false
# Leave blank to use $work_dir/logs/newsletter-backend.log
LOG_FILE=


# ═════════════════════════════════════════════════════════════════════════════
# LLM PROVIDERS
#
# Configure at least one of the blocks below. mars_cmbagent auto-detects
# which providers are available from the env vars that are set.
# Pin a specific one with CMBAGENT_LLM_PROVIDER=<provider_id>.
#
#   Supported provider ids:
#     openai · anthropic · azure · aws_bedrock · google · mistral ·
#     enterprise_gateway
# ═════════════════════════════════════════════════════════════════════════════

# Explicit provider selection (optional — leave blank for auto-detection).
# CMBAGENT_LLM_PROVIDER=azure


# ─── OpenAI (direct) ────────────────────────────────────────────────────────
OPENAI_API_KEY=


# ─── Anthropic (Claude API, direct) ─────────────────────────────────────────
ANTHROPIC_API_KEY=


# ─── Azure OpenAI ───────────────────────────────────────────────────────────
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_VERIFY_SSL=true


# ─── AWS Bedrock (Claude / Titan / Llama on Bedrock) ────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1
AWS_PROFILE=


# ─── Google Gemini ──────────────────────────────────────────────────────────
GOOGLE_API_KEY=


# ─── Mistral (direct) ───────────────────────────────────────────────────────
MISTRAL_API_KEY=


# ═════════════════════════════════════════════════════════════════════════════
# ENTERPRISE LLM GATEWAY (optional)
#
# Use this when your organisation fronts LLM traffic behind an internal
# OpenAI-wire-compatible gateway that expects a multi-stage auth flow
# (typical shape: OAuth2 grant → optional session-JWT exchange → OpenAI
# /chat/completions with rotating bearer + session headers).
#
# What the adapter handles automatically (do NOT try to configure these):
#   • Token caching per process (thread-safe, single-flight fetches).
#   • Auto-refresh on TTL expiry (uses `expires_in` from the response,
#     with a 60-second safety margin baked in).
#   • Transparent retry on HTTP 401 after invalidating both cached tokens.
#   • Fresh W3C `traceparent` header on every session-JWT and gateway call.
#   • TLS verification against a corporate CA bundle when configured.
#   • HTTP(S) proxies.
#
# Activate by setting one of:
#   CMBAGENT_LLM_PROVIDER=enterprise_gateway
#   CMBAGENT_ENTERPRISE_GATEWAY_ENABLED=true
# ═════════════════════════════════════════════════════════════════════════════

# CMBAGENT_LLM_PROVIDER=enterprise_gateway
# CMBAGENT_ENTERPRISE_GATEWAY_ENABLED=false

# --- Stage 1: OAuth2 token endpoint (REQUIRED) ------------------------------
# ENTERPRISE_LLM_TOKEN_URL=https://idp.example.com/oauth2/token
# ENTERPRISE_LLM_GRANT_TYPE=password            # password | client_credentials
# ENTERPRISE_LLM_USERNAME=svc-account-username  # required when grant_type=password
# ENTERPRISE_LLM_PASSWORD=                      # password OR client_secret
# ENTERPRISE_LLM_CLIENT_ID=
# ENTERPRISE_LLM_RESOURCE=                      # ADFS resource-owner grant only

# --- Stage 2: session-JWT exchange (OPTIONAL — leave blank to skip) ---------
# When ENTERPRISE_LLM_SESSION_URL is blank, the adapter sends only the
# stage-1 access token and skips this stage entirely. The `traceparent`
# header is auto-injected — no need to configure it here.
# ENTERPRISE_LLM_SESSION_URL=https://portal.example.com/api/auth/session-jwt
# ENTERPRISE_LLM_SESSION_BODY={"access_token":"{access_token}"}   # set only if the endpoint expects a body; supports {access_token}, {username}

# --- Gateway call (OpenAI wire-compatible /v1/chat/completions) -------------
# ENTERPRISE_LLM_GATEWAY_BASE_URL=https://gateway.example.com/v1/
# ENTERPRISE_LLM_CONSUMER_APPLICATION=my-application-id

# --- Model mapping (OPTIONAL — most deployments don't need this) ------------
# Only set if the gateway exposes models under non-canonical identifiers
# (e.g. "gpt-4o" → "gpt-4-omni") or gates access to a subset of models.
# ENTERPRISE_LLM_MODEL_MAP_JSON={"gpt-4o":"gpt-4o","gpt-4.1":"gpt-4.1"}
# ENTERPRISE_LLM_DEFAULT_MODEL=gpt-4o

# --- TLS / networking (set only if the defaults don't match your setup) -----
# ENTERPRISE_LLM_CA_BUNDLE=/etc/ssl/certs/corp-ca-bundle.pem
# ENTERPRISE_LLM_VERIFY_SSL=true                # set to "false" for dev only
# ENTERPRISE_LLM_PROXIES_JSON={"https":"http://proxy.corp:8080"}

# --- Advanced overrides (rarely needed; sensible defaults ship out of box) --
# Uncomment ONLY when your gateway deviates from OAuth2 / OIDC conventions.
# Every value shown below is the built-in default.
# ENTERPRISE_LLM_SCOPE=                                 # OAuth2 scope
# ENTERPRISE_LLM_TOKEN_ENCODING=form                    # form | json (stage-1 body encoding)
# ENTERPRISE_LLM_TOKEN_FIELD=access_token               # stage-1 response field
# ENTERPRISE_LLM_TOKEN_TTL_SECONDS=3300                 # fallback TTL if no expires_in
# ENTERPRISE_LLM_SESSION_METHOD=POST                    # stage-2 HTTP method
# ENTERPRISE_LLM_SESSION_TOKEN_FIELD=token              # stage-2 response field
# ENTERPRISE_LLM_SESSION_TTL_SECONDS=900                # fallback TTL if no expires_in
# ENTERPRISE_LLM_SESSION_EXTRA_HEADERS_JSON={}          # extra headers for the session-JWT call (traceparent already auto-added)
# ENTERPRISE_LLM_ACCESS_HEADER=Authorization            # renamed if gateway expects a different key
# ENTERPRISE_LLM_SESSION_HEADER=X-Authorization-Session
# ENTERPRISE_LLM_CONSUMER_HEADER=X-Consumer-Application
# ENTERPRISE_LLM_EXTRA_HEADERS_JSON={}                  # extra per-call gateway headers (traceparent already auto-added)
# ENTERPRISE_LLM_AUTH_TIMEOUT_SECONDS=30
# ENTERPRISE_LLM_CHAT_TIMEOUT_SECONDS=120
# ENTERPRISE_LLM_MAX_AUTH_RETRIES=2


# ═════════════════════════════════════════════════════════════════════════════
# Per-role model overrides (optional, consumed by mars_cmbagent)
# Override any role globally without editing model_config.yaml.
# ═════════════════════════════════════════════════════════════════════════════
# CMBAGENT_DEFAULT_MODEL=
# CMBAGENT_PLANNER_MODEL=
# CMBAGENT_PLAN_REVIEWER_MODEL=
# CMBAGENT_RESEARCHER_MODEL=
# CMBAGENT_ORCHESTRATION_MODEL=
# CMBAGENT_FORMATTER_MODEL=


# ═════════════════════════════════════════════════════════════════════════════
# Long-form newsletter generation tunables (optional)
# ═════════════════════════════════════════════════════════════════════════════

# Stage 4 writes the newsletter section-by-section so the final draft can be
# 60–90 KB. Set to 0 to fall back to the legacy single-call writer.
STAGE4_SECTION_MODE=1

# cmbagent ships a 25 000-char per-message content cap that splices a
# "[content truncated: N → M chars]" banner into long messages. Raise it
# here for long-form runs; lower to reduce token pressure.
CMBAGENT_MAX_MSG_CONTENT_CHARS=200000

# Stage 5 editor max output tokens. Must comfortably cover the longest draft
# you expect to produce.
STAGE5_EDITOR_MAX_TOKENS=32000

# Optional: pin the Stage 5 model (passes through to litellm verbatim).
# STAGE5_MODEL=
NEWSLETTER_AI_STAGE_TIMEOUT_S=2000 # increase more if you find any timeout error
# ── Stage strategy (per-stage UI removed — configure here) ───────────────────
# Invocation mode per stage. Values: one_shot | planning_and_control | deep_research
# NEWSLETTER_DEFAULT_MODE sets the fallback for every AI stage (2–5);
# NEWSLETTER_STAGE_{n}_MODE overrides a single stage. Absent both → one_shot.
# NEWSLETTER_DEFAULT_MODE=planning_and_control
# NEWSLETTER_STAGE_2_MODE=planning_and_control
# NEWSLETTER_STAGE_3_MODE=one_shot
# NEWSLETTER_STAGE_4_MODE=planning_and_control
# NEWSLETTER_STAGE_5_MODE=one_shot

# Pin one model for the whole pipeline (passes through to cmbagent verbatim).
# NEWSLETTER_DEFAULT_MODEL=

# Stage-2 collection knobs (used when the request omits mode_config).
# NEWSLETTER_STAGE_2_TOP_COMPANIES=12
# NEWSLETTER_STAGE_2_MIN_SOURCES=30
# NEWSLETTER_STAGE_2_ENRICH=true

# Stage-5 per-section LLM polish. OFF by default: it rewrites each section and,
# despite a strict URL-set guard, adds cost + latency. Turn on only if desired.
# NEWSLETTER_STAGE5_ENHANCE=false

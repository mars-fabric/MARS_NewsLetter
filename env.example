# ──────────────────────────────────────────────────────────────────────────────
# MARS-NewsLetter — environment configuration
# Copy to .env and fill in the values that apply to your setup.
# ──────────────────────────────────────────────────────────────────────────────

# ── App / server ──────────────────────────────────────────────────────────────
NEWSLETTER_APP_TITLE=MARS-NewsLetter API
NEWSLETTER_APP_VERSION=0.1.0
NEWSLETTER_DEBUG=false

# Bind address and port for the FastAPI server. `run.py` reads these.
HOST=0.0.0.0
PORT=8000
# Set to "true" to enable uvicorn auto-reload (development only).
NEWSLETTER_ENABLE_RELOAD=false

# Comma-separated list of allowed CORS origins for the API.
NEWSLETTER_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Where stage outputs (markdown, JSON, PDF) and logs are written.
# Created automatically on startup if it does not already exist.
NEWSLETTER_DEFAULT_WORK_DIR=~/Desktop/cmbdir

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=false
# Leave LOG_FILE blank to use the default ($work_dir/logs/backend.log).
LOG_FILE=

# ── LLM providers (one of these must be configured) ───────────────────────────
# OpenAI direct
OPENAI_API_KEY=

# Anthropic direct (Claude API)
ANTHROPIC_API_KEY=

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_VERIFY_SSL=true

# AWS Bedrock (Claude on Bedrock)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1
AWS_PROFILE=

# Google (Gemini) — optional
GOOGLE_API_KEY=

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_CMBAGENT_WORK_DIR=~/Desktop/cmbdir
NEXT_PUBLIC_DEBUG=false

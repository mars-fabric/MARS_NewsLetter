# MARS-NewsLetter Frontend Environment Variables
# Copy this file to .env.local and update the values as needed.
# Anything prefixed with NEXT_PUBLIC_ is inlined into the browser bundle at
# build time — NEVER put secrets here.

# Backend API URL
# Must match HOST:PORT for the FastAPI server (root .env / `run.py`).
# For remote access: http://<server-ip>:<PORT>
NEXT_PUBLIC_API_URL=http://localhost:8000

# WebSocket URL (derived from API URL if not set)
# Only override if your WS endpoint uses a different host/port than the API.
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Work directory for task outputs and logs (informational only — the backend
# is the authoritative source of truth for the actual on-disk path).
# Must match NEWSLETTER_DEFAULT_WORK_DIR in the backend env.
NEXT_PUBLIC_CMBAGENT_WORK_DIR=./cmbdir

# Optional: Enable debug mode (verbose console logging)
NEXT_PUBLIC_DEBUG=false
